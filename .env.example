# Copy to .env and fill in real values. Never commit .env.

# Required for live OpenAI calls (not needed for --dry-run)
OPENAI_API_KEY=

# Model id (default gpt-6-astra). Override if your account uses a different id.
OPENAI_MODEL=gpt-6-astra

# Shared secret that TradingView (or your test script) must send
# as header X-Webhook-Secret or field "secret" in the JSON body
WEBHOOK_SECRET=change-me-to-a-long-random-string

# HTTP port for the API + dashboard
PORT=3000
